{
  "workspaces": [
    "docs",
    "src",
    "test"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:types",
    "build:esm": "tsc --project ./tsconfig.build.json --module nodenext --outDir ./src/_esm --declaration false --declarationMap false --sourceMap false && printf '{\"type\": \"module\",\"sideEffects\":false}' > ./src/_esm/package.json",
    "build:types": "tsc --project ./tsconfig.build.json --module nodenext --declarationDir ./src/_types --emitDeclarationOnly --declaration --declarationMap false",
    "changeset": "changeset",
    "changeset:publish": "npm run build && changeset publish",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['src/_esm','src/_types'])fs.rmSync(d,{recursive:true,force:true})\"",
    "docs:build": "cd docs && npm run build",
    "docs:dev": "cd docs && npm run dev",
    "docs:preview": "cd docs && npm run preview",
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "start": "tsc --noEmit --watch",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && cd test && tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
