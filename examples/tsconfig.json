{
  "compilerOptions": {
    // ESM throughout: @oceanprotocol/lib and @oceanprotocol/ddo-js are ESM-only, and tsx
    // runs these files directly, so there is no build output to configure.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": ["*.ts", "scenarios/**/*.ts"]
}
