# Which network to run against. See config.ts for what each one points at.
# One of: PONTUSXDEV, PONTUSXTEST, OASISSAPPHIRE, OPSEPOLIA, LOCAL, CUSTOM
#
#   OPSEPOLIA  OP Sepolia (11155420), a public testnet. Contract addresses come from
#              ocean.js's ConfigHelper; set OCEAN_NODE_URI. No payment token is assumed:
#              set PRICING_TOKEN_* below for fixed prices.
#   LOCAL      the local docker stack only: chain 8996, with the contract addresses your
#              local deployment produced (the "LOCAL and CUSTOM" section below).
#   CUSTOM     any other chain: CHAIN_ID, RPC_URL and OCEAN_NODE_URI, plus the contract
#              addresses if ocean.js does not ship them for that chain.
NETWORK="PONTUSXDEV"

# The account that publishes and edits. Export it from MetaMask.
# It needs funds for gas, and for any non-free asset it buys.
PRIVATE_KEY="your-private-key"

# --- optional: a separate consumer ---
# The account that orders, downloads and runs compute (commands marked C in `help`).
# Unset, the publisher does everything. Its address is added to the allowlist of every
# allowlisted example asset, so it can actually consume them.
# CONSUMER_PRIVATE_KEY="the-consumer-private-key"
# More addresses to allowlist, comma separated, e.g. a consumer on another machine.
# CONSUMER_ADDRESSES="0x...,0x..."

# --- the ocean-node ---
# One node serves metadata, provider services and the indexer. It replaces the separate
# Aquarius and Provider URLs that nautilus v1 needed.
#
# You almost certainly need to set this; OPSEPOLIA and CUSTOM require it. nautilus v2
# requires an ocean-node, and the public Pontus-X endpoints still run the legacy standalone
# Provider (2.1.3) — so the defaults in config.ts point at ocean-node hostnames that do not
# resolve yet.
#
# Run `npm start -- check:node` to see which of the two you are talking to.
#
# Must be https://, except on localhost, 127.0.0.1, ::1 and *.localhost: nautilus sends the
# plaintext DDO pointer and the signed DDO there for encryption. The same rule applies to
# IPFS_UPLOAD_URL and S3_ENDPOINT below; these examples have no switch to relax it.
# OCEAN_NODE_URI="https://your-ocean-node.example.org"

# Optional RPC override for any network; required for CUSTOM.
# RPC_URL="https://sepolia.optimism.io"

# --- the DDO store: required to publish and edit ---
# nautilus writes an encrypted pointer on chain and stores the node-encrypted DDO envelope
# here. There is no default: the ocean-node's own bucket storage cannot hold DDOs, and
# nautilus rejects it. Pick one: ipfs | s3. Check it with `npm start -- store:check`,
# which runs the store's check() without any transaction.
# DDO_STORE="ipfs"

# IPFS, for DDO_STORE=ipfs. Any endpoint taking a multipart `file` upload. The ocean-node
# must be able to fetch the CID through its own IPFS gateway.
#   local Kubo: http://127.0.0.1:5001/api/v0/add
#   Pinata:     https://api.pinata.cloud/pinning/pinFileToIPFS (not pinJSONToIPFS), with
#               IPFS_JWT set to a Pinata API key JWT with the pin (pinFileToIPFS) and
#               unpin scopes.
# IPFS_UPLOAD_URL="http://127.0.0.1:5001/api/v0/add"
# Optional. Sent as `Authorization: Bearer <IPFS_JWT>`.
# IPFS_JWT="your-pinata-jwt"
# The gateway each envelope is read back from before the metadata transaction, ideally the
# node's own IPFS_GATEWAY. Required for anything but Kubo (Kubo is read back through its
# /api/v0/cat without it), e.g. https://gateway.pinata.cloud for Pinata.
# IPFS_GATEWAY_URL="https://gateway.pinata.cloud"
# Or publish without that read-back, explicitly:
# IPFS_VERIFY="false"

# S3, for DDO_STORE=s3 (AWS S3, Exoscale SOS, MinIO, ...).
# Two key pairs: the WRITE key uploads and never leaves this machine; the READ key is
# written, node-encrypted, into every on-chain pointer, forever. It must be read-only
# (s3:GetObject) and scoped to S3_PREFIX; rotating it breaks re-indexing of older assets.
# S3_NODE_ENDPOINT is how the node reaches the bucket, if that differs from S3_ENDPOINT
# (e.g. http://minio:9000 inside Docker); it may be plain http://, since only the node
# connects to it. S3_FORCE_PATH_STYLE defaults to true for an IP or localhost endpoint and
# to false otherwise; MinIO needs true. Set it to true as well when S3_NODE_ENDPOINT is an
# IP address or localhost, or the store refuses to start.
#   Exoscale SOS: S3_ENDPOINT=https://sos-<zone>.exo.io, S3_REGION=<zone>
#   MinIO:        S3_ENDPOINT=http://127.0.0.1:9000, S3_FORCE_PATH_STYLE=true
# S3_ENDPOINT=""
# S3_NODE_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_PREFIX="ddo/"
# S3_FORCE_PATH_STYLE=""
# S3_WRITE_ACCESS_KEY_ID=""
# S3_WRITE_SECRET_ACCESS_KEY=""
# S3_READ_ACCESS_KEY_ID=""
# S3_READ_SECRET_ACCESS_KEY=""

# --- optional: fixed pricing in a token you choose ---
# Used by the paid examples (publish:access-algorithm, publish:saas) on any network, ahead
# of the ready-made EURAU/OCEAN configs in config.ts. Without it, OPSEPOLIA and CUSTOM
# publish everything for free. Decimals are required with the address, because a wrong
# value misprices by orders of magnitude (EURAU has 6, most ERC-20s 18).
# PRICING_TOKEN_ADDRESS="0x..."
# PRICING_TOKEN_DECIMALS="6"
# PRICING_FIXED_RATE="1"

# --- optional: what a node may charge ---
# The node sets the provider fee of every download and compute input, and the amount a
# compute job locks in escrow. nautilus pays a non-zero one only up to these ceilings and
# otherwise throws before anything is spent, naming what the node asked for. Format:
# "<token address>:<amount in the token's smallest unit>", comma separated for several
# tokens (1 token at 18 decimals is 1000000000000000000).
# Unset MAX_PROVIDER_FEE: only zero provider fees are paid.
# Unset MAX_ESCROW_PAYMENT: compute:paid allows what the environment advertises for the job.
# MAX_PROVIDER_FEE="0x...:1000000000000000000"
# MAX_ESCROW_PAYMENT="0x...:5000000000000000000"
# The escrow contract paid compute funds. Unset, nautilus funds the chain's EnterpriseEscrow
# from Ocean's address data (its Escrow where the data lists no EnterpriseEscrow), the
# contract ocean-node 4.2.0 uses, whatever the node names. ocean.js ships that data for
# some chains (OP Sepolia); for LOCAL, set ADDRESS_FILE to your deployment's address.json.
# Set ESCROW_ADDRESS to the chain's EnterpriseEscrow contract where the address data has no
# escrow (PONTUSXDEV among them); it is then the only escrow funded.
# ESCROW_ADDRESS="0x..."

# --- optional: indexer patience ---
# How long publish and edit wait for the node to index a change, in milliseconds.
# Defaults: 300000 (5 minutes) and 7000. Each poll is up to two requests, and ocean-node
# rate-limits each IP to MAX_REQ_PER_MINUTE (default 30), so keep the interval at 4000 or
# more on a default node. On timeout the change is still on chain;
# `npm start -- asset:indexing-state <txId>` shows what the node recorded.
# INDEXER_TIMEOUT_MS="600000"
# INDEXER_INTERVAL_MS="10000"

# --- optional: a record of what you published ---
# One JSON line per publish and edit: DID, NFT, datatokens, tx and the store pointer
# (without credentials), so assets can be revoked and CIDs unpinned later.
PUBLISH_LOG="published.jsonl"

# --- optional: verbose logging ---
# Set to "true" to turn on nautilus' verbose log level.
# VERBOSE="true"

# --- optional: where the example asset files are served from ---
# You never fetch this URL — the ocean-node does, to encrypt the files object at publish
# time and to stream the data on download. So it has to resolve from inside the node's
# network, not from your shell — which is why serving the files locally means
# host.docker.internal rather than a localhost URL.
#
# Defaults to this repository's examples/example_publish_assets on GitHub.
# ASSET_BASE_URL="http://host.docker.internal:8081"

# --- optional: the container the algorithm examples run in ---
# Image digests are per platform: the default checksum is the linux/amd64 one, and an
# Apple Silicon host resolves node:18.17.1 to a different digest entirely. ocean-node
# verifies the manifest before it will start a job, so on arm64 you need to override it.
# `docker buildx imagetools inspect node:18.17.1` prints the per-platform digests.
# ALGO_IMAGE_NAME="node"
# ALGO_IMAGE_TAG="18.17.1"
# ALGO_IMAGE_CHECKSUM="sha256:..."

# --- LOCAL and CUSTOM networks ---
# LOCAL is chain 8996 only; RPC_URL and OCEAN_NODE_URI default to 127.0.0.1:8545 and
# 127.0.0.1:8001. CUSTOM needs CHAIN_ID, RPC_URL and OCEAN_NODE_URI.
# CHAIN_ID="8996"
# Contract addresses: required for LOCAL (a fresh deployment mints new ones); for CUSTOM
# only where ocean.js's ConfigHelper has none for CHAIN_ID.
# NFT_FACTORY_ADDRESS="0x..."
# FIXED_RATE_EXCHANGE_ADDRESS="0x..."
# DISPENSER_ADDRESS="0x..."
# LOCAL only, optional: the stack's OCEAN token, for the FIXED_OCEAN pricing config.
# OCEAN_TOKEN_ADDRESS="0x..."

# --- optional: end-to-end scenario ---
# `npm run scenario:e2e` revokes every asset it published at the end (one-way). Keep them:
# E2E_KEEP_ASSETS="true"

# --- optional: walt.id identity, for the credential-gated flows ---
# SSI_WALLET_API="https://wallet.example.org"
# Pin a wallet, key and DID of the publisher. Leave unset to use the first the account
# owns — run `npm start -- ssi:connect` to print what is available.
# SSI_WALLET_ID=""
# SSI_WALLET_KEY_ID=""
# SSI_WALLET_DID=""
# The consumer's wallet and DID, with CONSUMER_PRIVATE_KEY (`ssi:connect consumer`).
# CONSUMER_SSI_WALLET_ID=""
# CONSUMER_SSI_WALLET_DID=""
