# --- integration test signers (Pontus-X devnet) ---
# Two funded accounts: the first publishes, the second consumes.
PRIVATE_KEY_TESTS_1='0x1234...'
PRIVATE_KEY_TESTS_2='0x1234...'

# --- ocean-node ---
# One node serves metadata (the old Aquarius API), provider services and the indexer.
# Required by the integration suite; without it the suite skips itself.
# Must be https://, except on localhost / 127.0.0.1 / ::1 / *.localhost (nautilus sends the
# plaintext DDO pointer there for encryption).
NODE_URL='https://node.example.org'

# Optional RPC override. Defaults to https://rpc.dev.pontus-x.eu
# RPC='https://rpc.dev.pontus-x.eu'

# The chain's Escrow contract, for the paid compute test. nautilus funds only the chain
# config's escrow, whatever the node names; ocean.js ships it for some chains, and reads it
# from ADDRESS_FILE on a local deployment. Set it for the others (Pontus-X devnet included).
# ESCROW_ADDRESS='0x...'

# --- DDO store (where the suite stores DDOs) ---
# ocean-node 4.2 cannot read DDOs from its own bucket storage, so the encrypted DDO
# envelope goes to IPFS (default) or S3. Pick one: ipfs | s3
# DDO_STORE='ipfs'

# IPFS, required when DDO_STORE=ipfs. Any endpoint taking a multipart `file` upload works;
# the node under test must be able to fetch the CID through its IPFS gateway.
#   local Kubo: http://127.0.0.1:5001/api/v0/add
#   Pinata:     https://api.pinata.cloud/pinning/pinFileToIPFS (set IPFS_JWT too)
IPFS_UPLOAD_URL='http://127.0.0.1:5001/api/v0/add'

# Optional. Sent as `Authorization: Bearer <IPFS_JWT>`, e.g. a Pinata JWT with the
# pinFileToIPFS scope (and unpin, to clean up).
# IPFS_JWT='...'

# A gateway to read each envelope back from before the metadata transaction, ideally the
# node's own IPFS_GATEWAY (local Kubo: http://127.0.0.1:8080). Optional for Kubo, which is
# otherwise read back through its own /api/v0/cat; required for Pinata or any other upload
# endpoint, whose store check() fails without it.
# IPFS_GATEWAY_URL=''

# S3, required when DDO_STORE=s3 (AWS S3, Exoscale SOS, MinIO, ...).
# Two key pairs: the WRITE key uploads and never leaves this machine; the READ key is
# written, node-encrypted, into every on-chain pointer and must be read-only, scoped to
# S3_PREFIX. S3_NODE_ENDPOINT is how the node reaches the bucket, if that differs from
# S3_ENDPOINT (e.g. http://minio:9000 inside Docker; plain http is fine there, only the
# node connects to it). S3_ENDPOINT must be https:// unless it is a loopback host. MinIO,
# and any IP or localhost endpoint, needs S3_FORCE_PATH_STYLE=true.
# Exoscale SOS: S3_ENDPOINT=https://sos-<zone>.exo.io, S3_REGION=<zone>.
# S3_ENDPOINT=
# S3_NODE_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_PREFIX=
# S3_FORCE_PATH_STYLE=
# S3_WRITE_ACCESS_KEY_ID=
# S3_WRITE_SECRET_ACCESS_KEY=
# S3_READ_ACCESS_KEY_ID=
# S3_READ_SECRET_ACCESS_KEY=

# --- walt.id identity (only for credential-gated assets) ---
# SSI_WALLET_API='https://wallet.example.org'
# SSI_WALLET_ID='...'
# SSI_WALLET_DID='did:key:...'
